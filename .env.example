# Backend (.env)
# Copy to .env and fill values. Do NOT commit real secrets.

NODE_ENV=development
PORT=3001

# Database
DATABASE_URL=postgresql://postgres:CHANGE_ME@localhost:5432/med_delivery?schema=public

# Redis
REDIS_URL=redis://localhost:6379

# Auth
JWT_SECRET=CHANGE_ME_LONG_RANDOM
JWT_EXPIRES_IN=1h

# Optional: cookie-mode auth (httpOnly cookies, requires CORS credentials=true)
# - Keep this off in dev unless you also set matching CORS_ORIGIN.
AUTH_COOKIE_MODE=0

# CORS (comma-separated). Use your deployed frontend URL(s) in production.
CORS_ORIGIN=http://localhost:3000

# WebSocket CORS (optional override; falls back to CORS_ORIGIN)
WS_CORS_ORIGIN=http://localhost:3000

# If behind a reverse proxy (nginx/ALB), set TRUST_PROXY=1
TRUST_PROXY=0

# Swagger (recommended off in production)
DISABLE_SWAGGER=0

# Payments
PAYMENTS_DEV_MODE=true

# Default payment mode for new orders (switchable later)
# - PAY_AFTER_ACCEPT (current default)
# - PAY_FIRST (future)
DEFAULT_PAYMENT_MODE=PAY_AFTER_ACCEPT

# Loadtest toggles
DISABLE_RATELIMIT=0
RATE_LIMIT_WINDOW_MS=60000
RATE_LIMIT_MAX=120
LOADTEST_MODE=false

# Retention (days). Set to 0/empty to disable.
RETENTION_NOTIFICATIONS_DAYS=30
RETENTION_LOGIN_AUDIT_DAYS=90
RETENTION_CHAT_DAYS=30
RETENTION_SUPPORT_DAYS=365
RETENTION_AUDIT_LOG_DAYS=365
RETENTION_SESSION_DAYS=30
RETENTION_OTP_DAYS=7

# Upload limits
UPLOAD_MAX_BYTES=5242880

# Admin hardening (optional but recommended)
# When set, only these email(s) can change sensitive app-config like mobile tabs/categories/banners.
# Comma/space separated.
SUPERADMIN_EMAILS=superadmin_live@example.com

# Observability (optional)
# SENTRY_DSN=
# SENTRY_ENVIRONMENT=development
# SENTRY_TRACES_SAMPLE_RATE=0.0
