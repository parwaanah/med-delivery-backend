{
  "name": "medicine-delivery-backend",
  "version": "1.0.0",
  "description": "Enterprise-grade Medicine Delivery Backend (NestJS + Prisma + JWT + Redis + BullMQ)",
  "main": "dist/main.js",
  "scripts": {
    "prebuild": "rimraf dist",
    "build": "nest build",
    "start": "node dist/main.js",
    "start:dev": "nest start --watch",
    "start:prod": "node dist/main.js",
    "lint": "eslint \"{src,apps,libs,test}/**/*.ts\" --fix",
    "test": "jest",
    "test:e2e": "jest --config ./test/jest-e2e.json",
    "prisma:generate": "npx prisma generate",
    "prisma:migrate": "npx prisma migrate dev --name init",
    "prisma:deploy": "npx prisma migrate deploy",
    "seed": "ts-node prisma/seed.ts",
    "check:types": "tsc --noEmit",
    "generate:medicines": "node prisma/generate_medicines.js",
    "seed:medicines": "node prisma/seed.js",
    "e2e:roles": "ts-node scripts/test-e2e-roles.ts"
  },
  "dependencies": {
    "@nestjs/axios": "^4.0.1",
    "@nestjs/bullmq": "^11.0.4",
    "@nestjs/common": "^10.3.10",
    "@nestjs/config": "^3.3.0",
    "@nestjs/core": "^10.3.10",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.3.10",
    "@nestjs/platform-socket.io": "^10.3.10",
    "@nestjs/schedule": "^6.0.1",
    "@nestjs/serve-static": "^4.0.2",
    "@nestjs/throttler": "^6.4.0",
    "@nestjs/websockets": "^10.3.10",
    "@prisma/client": "^5.22.0",
    "@sentry/node": "^10.38.0",
    "@types/passport-google-oauth20": "^2.0.17",
    "bcrypt": "^6.0.0",
    "bcryptjs": "^3.0.3",
    "bullmq": "^5.63.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "cloudinary": "^2.8.0",
    "csv-writer": "^1.6.0",
    "date-fns": "^4.1.0",
    "express-rate-limit": "^8.2.1",
    "helmet": "^8.1.0",
    "ioredis": "^5.8.2",
    "lru-cache": "^10.4.3",
    "nanoid": "^5.1.6",
    "node-fetch": "^2.7.0",
    "otplib": "^12.0.1",
    "passport": "^0.7.0",
    "passport-google-oauth20": "^2.0.0",
    "passport-jwt": "^4.0.1",
    "pdfkit": "^0.17.2",
    "prom-client": "^15.1.3",
    "razorpay": "^2.9.6",
    "reflect-metadata": "^0.2.1",
    "rxjs": "^7.8.1",
    "socket.io": "^4.8.1",
    "streamifier": "^0.1.1",
    "stripe": "^19.3.0",
    "swagger-ui-express": "^5.0.1",
    "uuid": "^13.0.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@nestjs/cli": "^10.3.2",
    "@nestjs/schematics": "^10.1.1",
    "@nestjs/swagger": "^7.3.1",
    "@nestjs/testing": "^10.3.10",
    "@types/bcrypt": "^6.0.0",
    "@types/bcryptjs": "^2.4.6",
    "@types/express": "^4.17.21",
    "@types/jest": "^29.5.12",
    "@types/node": "^20.19.24",
    "@types/node-fetch": "^2.6.13",
    "@types/passport-jwt": "^3.0.8",
    "@types/pdfkit": "^0.17.3",
    "@types/redis": "^4.0.10",
    "@types/socket.io": "^3.0.1",
    "@types/stripe": "^8.0.416",
    "@types/supertest": "^2.0.16",
    "eslint": "^9.39.1",
    "eslint-config-prettier": "^9.1.0",
    "jest": "^29.7.0",
    "pm2": "^6.0.13",
    "prettier": "^3.3.3",
    "prisma": "^5.22.0",
    "rimraf": "^6.1.2",
    "supertest": "^7.1.1",
    "ts-jest": "^29.1.2",
    "ts-loader": "^9.5.1",
    "ts-node": "^10.9.2",
    "typescript": "^5.6.3",
    "typescript-eslint": "^8.46.3"
  },
  "prisma": {
    "seed": "ts-node prisma/seed.ts"
  },
  "engines": {
    "node": ">=18.0.0"
  },
