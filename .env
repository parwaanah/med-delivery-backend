# =====================================================
# DATABASE
# =====================================================
DATABASE_URL=postgresql://postgres:Hello%40123@127.0.0.1:5432/med_delivery?schema=public

# =====================================================
# AUTH / JWT
# =====================================================
JWT_SECRET=dev-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_TTL=2592000

# =====================================================
# SERVER CONFIG
# =====================================================
PORT=3001
NODE_ENV=development
LOG_LEVEL=info

# =====================================================
# REDIS CONFIG
# =====================================================
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# =====================================================
# SURGE ENGINE
# =====================================================
SURGE_BASE=1.0
SURGE_MAX=2.5
ENABLE_SURGE=true
ENABLE_GEOSURGE=true
GEO_DEFAULT_RADIUS_KM=5

# =====================================================
# PAYMENT (RAZORPAY)
# =====================================================
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# =====================================================
# LEGACY (SAFE TO DELETE LATER)
# =====================================================
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# =====================================================
# WEBHOOK KEYS (PHARMACY / RIDER)
# =====================================================
PHARMACY_WEBHOOK_KEY=pharma_key_123
RIDER_WEBHOOK_KEY=rider_key_123

# =====================================================
# FEATURE FLAGS / HYBRID CONFIG
# =====================================================

# DEV: 1 minute before escalating to admin
# PROD: 5–10 minutes
ESCALATION_MINUTES=1

# DEV: Riders manually accept or reject (no auto-assign)
# PROD: true
AUTO_ASSIGN_RIDER=false

# DEV: Refunds done manually
# PROD: true
AUTO_REFUND=false

ORDER_ASSIGN_QUEUE_NAME=order_assign

# Rider search radius in KM
RIDER_SEARCH_KM=5
