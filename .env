# ------------------------------
# DATABASE
# ------------------------------
DATABASE_URL=postgresql://postgres:Hello%40123@127.0.0.1:5432/med_delivery?schema=public

# ------------------------------
# AUTH / JWT
# ------------------------------
JWT_SECRET=dev-secret
JWT_EXPIRES_IN=1h
JWT_REFRESH_TTL=2592000

# ------------------------------
# SERVER CONFIG
# ------------------------------
PORT=3001
NODE_ENV=development

# ------------------------------
# REDIS CONFIG
# ------------------------------
REDIS_HOST=127.0.0.1
REDIS_PORT=6379
REDIS_URL=redis://127.0.0.1:6379

# ------------------------------
# SURGE ENGINE
# ------------------------------
SURGE_BASE=1.0
SURGE_MAX=2.5

# ------------------------------
# PAYMENT (RAZORPAY)
# ------------------------------
RAZORPAY_KEY_ID=your_key_id
RAZORPAY_KEY_SECRET=your_key_secret
RAZORPAY_WEBHOOK_SECRET=your_webhook_secret

# ------------------------------
# LEGACY (you can delete stripe)
# ------------------------------
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=

# ------------------------------
# WEBHOOK KEYS (your pharmacy + rider)
# ------------------------------
PHARMACY_WEBHOOK_KEY=pharma_key_123
RIDER_WEBHOOK_KEY=rider_key_123

# ------------------------------
# FEATURE FLAGS
# ------------------------------
ENABLE_GEOSURGE=true
ENABLE_SURGE=true
AUTO_ASSIGN_RIDER=true
FAIL_SAFE_ORDER_CREATION=true
GEO_DEFAULT_RADIUS_KM=5
ORDER_ASSIGN_QUEUE_NAME=order_assign
LOG_LEVEL=info

# ------------------------------
# MISC
# ------------------------------
ESCALATION_MINUTES=1
