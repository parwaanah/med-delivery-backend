generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String?   @unique
  phone           String?   @unique
  password        String?
  googleId        String?   @unique

  emailVerified   Boolean   @default(false)
  phoneVerified   Boolean   @default(false)

  otpCode         String?
  otpExpiresAt    DateTime?
  mfaEnabled      Boolean   @default(false)
  mfaSecret       String?
  mfaTempSecret   String?
  mfaRecoveryCodes String[] @default([])

  role            UserRole  @default(CUSTOMER)
  status          String    @default("PENDING")
  approvedBy      Int?

  // Rider-specific control plane fields (do not overload `status` for availability)
  riderAvailability String  @default("OFFLINE")
  riderReasonCode   String?
  riderReasonNote   String?
  riderAvgRating    Float   @default(0)
  riderRatingCount  Int     @default(0)

  latitude        Float?
  longitude       Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  auditLogs             AuditLog[]
  receivedMessages      ChatMessage[] @relation("UserReceivedMessages")
  sentMessages          ChatMessage[] @relation("UserSentMessages")
  LoginAudit            LoginAudit[]
  receivedNotifications Notification[] @relation("ReceivedNotifications")
  sentNotifications     Notification[] @relation("SentNotifications")
  customerOrders        Order[] @relation("CustomerOrders")
  pharmacyOrders        Order[] @relation("PharmacyOrders")
  riderOrders           Order[] @relation("RiderOrders")
  riderShiftSessions    RiderShiftSession[] @relation("RiderShiftSessions")
  riderEarnings         RiderEarning[]
  riderRatingsReceived  RiderRating[] @relation("RiderRatingsReceived")
  riderRatingsGiven     RiderRating[] @relation("RiderRatingsGiven")
  riderStrikes          RiderStrike[]
  riderFraudSignals     RiderFraudSignal[]
  pharmacyInventory     PharmacyInventory[] @relation("PharmacyInventoryRelation")
  prescriptions         Prescription[]
  refreshTokens         RefreshToken[]
  sessions              Session[]
  approver              User? @relation("AdminApprovals", fields: [approvedBy], references: [id])
  approvedUsers         User[] @relation("AdminApprovals")

  partnerProfile        PartnerProfile?
  verificationDocs      VerificationDocument[]

  supportTicketsRequested SupportTicket[] @relation("SupportTicketRequester")
  supportTicketsAssigned  SupportTicket[] @relation("SupportTicketAssignee")
  supportMessages         SupportMessage[]

  refundRequestsRequested RefundRequest[] @relation("RefundRequestRequester")
  refundRequestsApproved  RefundRequest[] @relation("RefundRequestApprover")

  adminPermissions        AdminPermission[]

  addresses               UserAddress[]

  incidentsCreated        Incident[] @relation("IncidentCreatedBy")
  incidentsAssigned       Incident[] @relation("IncidentAssignedTo")
  incidentEvents          IncidentEvent[]
}

model AdminPermission {
  id        Int      @id @default(autoincrement())
  userId    Int
  code      String
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, code])
  @@index([userId])
  @@index([code])
}

model UserAddress {
  id        Int      @id @default(autoincrement())
  userId    Int
  label     String   @default("Home")
  name      String
  phone     String
  line1     String
  line2     String?  @default("")
  city      String
  state     String?  @default("")
  pin       String
  landmark  String?  @default("")
  isDefault Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, createdAt])
}

model Medicine {
  id           Int                 @id @default(autoincrement())
  name         String
  sku          String?             @unique
  salt         String?
  manufacturer String?
  price        Float?              @default(0)
  imageUrl     String?
  createdAt    DateTime            @default(now())
  category     MedicineCategory    @default(NON_RX)
  rxType       PrescriptionType    @default(NONE)
  orderItems   OrderItem[]
  inventory    PharmacyInventory[]
}



model PharmacyInventory {
  id           Int      @id @default(autoincrement())
  pharmacyId   Int
  medicineId   Int
  stock        Int      @default(0)
  createdAt    DateTime @default(now())
  deletedAt    DateTime?
  discount     Float    @default(0)
  mrp          Decimal  @db.Decimal(12, 2)
  sellingPrice Decimal  @db.Decimal(12, 2)
  medicine     Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  pharmacy     User     @relation("PharmacyInventoryRelation", fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, medicineId])
}

model Prescription {
  id         Int      @id @default(autoincrement())
  customerId Int
  url        String
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
  orders     Order[]
  user       User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Order {
  id                   Int             @id @default(autoincrement())
  customerId           Int
  pharmacyId           Int
  riderId              Int?
  status               OrderStatus     @default(PENDING)
  totalPrice           Float
  // Minimal payment tracking (keeps OrderStatus focused on logistics)
  paymentStatus        String          @default("UNPAID") // UNPAID | REQUESTED | PAID
  paymentRequestedAt   DateTime?
  paidAt               DateTime?
  riderAssignedAt      DateTime?
  reachedPharmacyAt    DateTime?
  pickedUpAt           DateTime?
  outForDeliveryAt     DateTime?
  deliveredAt          DateTime?
  deliveryProofUrl     String?
  deliverySignatureUrl String?
  deliveryOtp          String?
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?
  paymentMode          PaymentMode     @default(PAY_AFTER_ACCEPT)
  prescriptionId       Int?
  requiresPrescription Boolean         @default(false)

  // Delivery snapshot (immutable per-order for audit/history)
  deliveryAddressText  String?
  deliveryName         String?
  deliveryPhone        String?
  deliveryLine1        String?
  deliveryLine2        String?         @default("")
  deliveryCity         String?
  deliveryState        String?         @default("")
  deliveryPin          String?
  deliveryLandmark     String?         @default("")
  deliveryNotes        String?         @default("")

  customer             User            @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)
  pharmacy             User            @relation("PharmacyOrders", fields: [pharmacyId], references: [id], onDelete: Cascade)
  prescription         Prescription?   @relation(fields: [prescriptionId], references: [id])
  rider                User?           @relation("RiderOrders", fields: [riderId], references: [id])
  items                OrderItem[]
  offers               OrderOffer[]
  timeline             OrderTimeline[]
  riderEarning         RiderEarning?
  riderRating          RiderRating?

  supportTickets       SupportTicket[]
  refundRequests       RefundRequest[]
  incidents            Incident[]
}

model OrderItem {
  id         Int       @id @default(autoincrement())
  orderId    Int
  medicineId Int?
  name       String
  quantity   Int
  price      Float
  medicine   Medicine? @relation(fields: [medicineId], references: [id])
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderOffer {
  id         Int      @id @default(autoincrement())
  orderId    Int
  pharmacyId Int?
  riderId    Int?
  offeredTo  String
  status     String   @default("PENDING")
  score      Int      @default(0)
  expiresAt  DateTime?
  respondedAt DateTime?
  rejectReason String?
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Notification {
  id         Int      @id @default(autoincrement())
  senderId   Int?
  receiverId Int
  type       String
  message    String
  meta       Json?
  status     String   @default("UNREAD")
  createdAt  DateTime @default(now())
  receiver   User     @relation("ReceivedNotifications", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User?    @relation("SentNotifications", fields: [senderId], references: [id])
}

model Session {
  id            Int            @id @default(autoincrement())
  userId        Int
  ip            String?
  userAgent     String?
  createdAt     DateTime       @default(now())
  expiresAt     DateTime
  revoked       Boolean        @default(false)
  refreshTokens RefreshToken[] @relation("SessionToRefreshTokens")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  sessionId Int?
  tokenHash String
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
  session   Session? @relation("SessionToRefreshTokens", fields: [sessionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

enum SupportTicketStatus {
  OPEN
  PENDING_ADMIN
  PENDING_USER
  RESOLVED
  CLOSED
}

enum SupportMessageType {
  USER
  ADMIN
  INTERNAL
}

model SupportTicket {
  id              Int                 @id @default(autoincrement())
  requesterId     Int
  orderId         Int?
  assignedAdminId Int?
  status          SupportTicketStatus @default(OPEN)
  subject         String
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  requester       User                @relation("SupportTicketRequester", fields: [requesterId], references: [id], onDelete: Cascade)
  order           Order?              @relation(fields: [orderId], references: [id], onDelete: SetNull)
  assignedAdmin   User?               @relation("SupportTicketAssignee", fields: [assignedAdminId], references: [id])
  messages        SupportMessage[]
  incidents       Incident[]

  @@index([requesterId, createdAt])
  @@index([status, updatedAt])
  @@index([assignedAdminId, updatedAt])
}

model SupportMessage {
  id        Int                @id @default(autoincrement())
  ticketId  Int
  senderId  Int?
  type      SupportMessageType
  message   String
  attachments Json?
  createdAt DateTime           @default(now())

  ticket    SupportTicket      @relation(fields: [ticketId], references: [id], onDelete: Cascade)
  sender    User?              @relation(fields: [senderId], references: [id], onDelete: SetNull)

  @@index([ticketId, createdAt])
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  resource  String?
  meta      Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model ServiceZone {
  id        Int      @id @default(autoincrement())
  name      String
  geojson   Json
  active    Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model LoginAudit {
  id        Int      @id @default(autoincrement())
  userId    Int?
  email     String?
  ip        String?
  userAgent String?
  eventType String
  role      String?
  success   Boolean  @default(true)
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model SurgeEvent {
  id         Int      @id @default(autoincrement())
  multiplier Float
  meta       Json?
  createdAt  DateTime @default(now())
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  text       String
  createdAt  DateTime @default(now())
  receiver   User     @relation("UserReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("UserSentMessages", fields: [senderId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[] @relation("CartItems")

  @@index([userId])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  cart      Cart    @relation("CartItems", fields: [cartId], references: [id])

  @@index([cartId])
}

model Transaction {
  id              String   @id @default(cuid())
  provider        String
  providerOrder   String?
  providerPayment String?
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("INR")
  status          String
  method          String?
  rawData         Json?
  createdAt       DateTime @default(now())
  orderId         Int?

  refundRequests  RefundRequest[]

  @@index([orderId])
  @@index([providerOrder])
}

model RiderSettlementBatch {
  id          Int      @id @default(autoincrement())
  periodStart DateTime
  periodEnd   DateTime
  status      String   @default("CREATED") // CREATED | PAID | CANCELED
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  earnings RiderEarning[]

  @@unique([periodStart, periodEnd])
  @@index([createdAt])
}

model RiderEarning {
  id               Int      @id @default(autoincrement())
  riderId          Int
  orderId          Int      @unique
  type             String   @default("EARNING") // EARNING | BONUS | PENALTY

  distanceKm       Float?
  baseFare         Decimal  @db.Decimal(12, 2)
  distanceFare     Decimal  @db.Decimal(12, 2)
  surgeMultiplier  Float    @default(1)
  surgeBonus       Decimal  @db.Decimal(12, 2)
  bonus            Decimal  @db.Decimal(12, 2)
  penalty          Decimal  @db.Decimal(12, 2)
  netAmount        Decimal  @db.Decimal(12, 2)

  status           String   @default("PENDING") // PENDING | SETTLED
  settledAt        DateTime?
  batchId          Int?
  meta             Json?

  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  rider            User                 @relation(fields: [riderId], references: [id], onDelete: Cascade)
  order            Order                @relation(fields: [orderId], references: [id], onDelete: Cascade)
  batch            RiderSettlementBatch? @relation(fields: [batchId], references: [id])

  @@index([riderId, createdAt])
  @@index([status, createdAt])
  @@index([batchId])
}

model PaymentAttempt {
  id            String   @id @default(cuid())
  attemptData   Json?
  createdAt     DateTime @default(now())
  providerOrder String?
}

model OrderTimeline {
  id        Int      @id @default(autoincrement())
  orderId   Int
  event     String
  data      String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum UserRole {
  ADMIN
  CUSTOMER
  PHARMACY
  RIDER
}

enum OrderStatus {
  PENDING
  NEEDS_CONFIRMATION
  ACCEPTED
  REJECTED
  ASSIGNED
  OUT_FOR_DELIVERY
  REACHED_PHARMACY
  PICKED_UP
  DELIVERED
  CANCELED
  PAID
}

enum MedicineCategory {
  NON_RX
  CHRONIC
  STRICT_RX
  COUGH
  HEADACHE
  DIABETES
  BABY_CARE
  COSMETICS
}

enum PrescriptionType {
  NONE
  SOFT
  HARD
}

enum PaymentMode {
  PAY_FIRST
  PAY_AFTER_ACCEPT
  PAY_AFTER_VERIFICATION
}

model OtpRequest {
  id        Int      @id @default(autoincrement())
  phone     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

enum RefundRequestStatus {
  PENDING
  APPROVED
  REJECTED
  CANCELED
}

model RefundRequest {
  id              Int                 @id @default(autoincrement())
  orderId         Int
  transactionId   String
  requestedById   Int
  status          RefundRequestStatus @default(PENDING)
  requestedAmount Decimal?            @db.Decimal(12, 2) // INR (rupees)
  approvedAmount  Decimal?            @db.Decimal(12, 2) // INR (rupees)
  reason          String?
  adminNote       String?
  approvedById    Int?
  resolvedAt      DateTime?
  createdAt       DateTime            @default(now())
  updatedAt       DateTime            @updatedAt

  order           Order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  transaction     Transaction         @relation(fields: [transactionId], references: [id], onDelete: Restrict)
  requestedBy     User                @relation("RefundRequestRequester", fields: [requestedById], references: [id], onDelete: Cascade)
  approvedBy      User?               @relation("RefundRequestApprover", fields: [approvedById], references: [id])

  @@index([orderId, createdAt])
  @@index([requestedById, createdAt])
  @@index([status, createdAt])
 }

model PartnerProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  role      UserRole
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model RiderShiftSession {
  id            Int      @id @default(autoincrement())
  riderId       Int
  startTime     DateTime @default(now())
  endTime       DateTime?
  durationSec   Int      @default(0)
  activeSec     Int      @default(0)
  idleSec       Int      @default(0)
  lastState     String   @default("IDLE") // ACTIVE | IDLE
  lastStateAt   DateTime @default(now())
  lastHeartbeat DateTime @default(now())
  endedReason   String?

  rider User @relation("RiderShiftSessions", fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([endTime])
}

model RiderRating {
  id         Int      @id @default(autoincrement())
  orderId    Int      @unique
  riderId    Int
  customerId Int
  rating     Int
  comment    String?
  createdAt  DateTime @default(now())

  order    Order @relation(fields: [orderId], references: [id], onDelete: Cascade)
  rider    User  @relation("RiderRatingsReceived", fields: [riderId], references: [id], onDelete: Cascade)
  customer User  @relation("RiderRatingsGiven", fields: [customerId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([customerId])
}

model RiderStrike {
  id        Int      @id @default(autoincrement())
  riderId   Int
  type      String
  points    Int      @default(1)
  reason    String?
  meta      Json?
  createdAt DateTime @default(now())

  rider User @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([createdAt])
}

model RiderFraudSignal {
  id        Int      @id @default(autoincrement())
  riderId   Int
  type      String
  severity  Int      @default(50)
  meta      Json?
  createdAt DateTime @default(now())

  rider User @relation(fields: [riderId], references: [id], onDelete: Cascade)

  @@index([riderId])
  @@index([createdAt])
}

model VerificationDocument {
  id        Int      @id @default(autoincrement())
  userId    Int
  url       String
  type      String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model Incident {
  id              Int      @id @default(autoincrement())
  title           String
  severity        String   @default("SEV3") // SEV1..SEV4 (string for flexibility)
  status          String   @default("OPEN") // OPEN | INVESTIGATING | MITIGATED | RESOLVED | CLOSED
  description     String?
  orderId         Int?
  supportTicketId Int?
  createdById     Int?
  assignedToId    Int?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  resolvedAt      DateTime?
  meta            Json?

  order           Order?        @relation(fields: [orderId], references: [id], onDelete: SetNull)
  supportTicket   SupportTicket? @relation(fields: [supportTicketId], references: [id], onDelete: SetNull)
  createdBy       User?         @relation("IncidentCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  assignedTo      User?         @relation("IncidentAssignedTo", fields: [assignedToId], references: [id], onDelete: SetNull)
  events          IncidentEvent[]

  @@index([status, createdAt])
  @@index([severity, createdAt])
  @@index([orderId])
  @@index([supportTicketId])
  @@index([assignedToId])
}

model IncidentEvent {
  id         Int      @id @default(autoincrement())
  incidentId Int
  actorId    Int?
  type       String   @default("COMMENT") // COMMENT | STATUS_CHANGE | ASSIGNMENT | LINKED_ORDER | LINKED_TICKET
  message    String
  createdAt  DateTime @default(now())
  meta       Json?

  incident Incident @relation(fields: [incidentId], references: [id], onDelete: Cascade)
  actor    User?    @relation(fields: [actorId], references: [id], onDelete: SetNull)

  @@index([incidentId, createdAt])
  @@index([actorId, createdAt])
}
