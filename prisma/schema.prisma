generator client {
  provider      = "prisma-client-js"
  binaryTargets = ["native", "windows", "debian-openssl-3.0.x"]
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id              Int       @id @default(autoincrement())
  name            String
  email           String?   @unique
  phone           String?   @unique
  password        String?
  googleId        String?   @unique

  emailVerified   Boolean   @default(false)
  phoneVerified   Boolean   @default(false)

  otpCode         String?
  otpExpiresAt    DateTime?

  role            UserRole  @default(CUSTOMER)
  status          String    @default("PENDING")
  approvedBy      Int?

  latitude        Float?
  longitude       Float?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  deletedAt       DateTime?

  auditLogs             AuditLog[]
  receivedMessages      ChatMessage[] @relation("UserReceivedMessages")
  sentMessages          ChatMessage[] @relation("UserSentMessages")
  LoginAudit            LoginAudit[]
  receivedNotifications Notification[] @relation("ReceivedNotifications")
  sentNotifications     Notification[] @relation("SentNotifications")
  customerOrders        Order[] @relation("CustomerOrders")
  pharmacyOrders        Order[] @relation("PharmacyOrders")
  riderOrders           Order[] @relation("RiderOrders")
  pharmacyInventory     PharmacyInventory[] @relation("PharmacyInventoryRelation")
  prescriptions         Prescription[]
  refreshTokens         RefreshToken[]
  sessions              Session[]
  approver              User? @relation("AdminApprovals", fields: [approvedBy], references: [id])
  approvedUsers         User[] @relation("AdminApprovals")

  partnerProfile        PartnerProfile?
  verificationDocs      VerificationDocument[]
}

model Medicine {
  id           Int                 @id @default(autoincrement())
  name         String
  sku          String?             @unique
  salt         String?
  manufacturer String?
  price        Float?              @default(0)
  imageUrl     String?
  createdAt    DateTime            @default(now())
  category     MedicineCategory    @default(NON_RX)
  rxType       PrescriptionType    @default(NONE)
  orderItems   OrderItem[]
  inventory    PharmacyInventory[]
}



model PharmacyInventory {
  id           Int      @id @default(autoincrement())
  pharmacyId   Int
  medicineId   Int
  stock        Int      @default(0)
  createdAt    DateTime @default(now())
  discount     Float    @default(0)
  mrp          Decimal  @db.Decimal(12, 2)
  sellingPrice Decimal  @db.Decimal(12, 2)
  medicine     Medicine @relation(fields: [medicineId], references: [id], onDelete: Cascade)
  pharmacy     User     @relation("PharmacyInventoryRelation", fields: [pharmacyId], references: [id], onDelete: Cascade)

  @@unique([pharmacyId, medicineId])
}

model Prescription {
  id         Int      @id @default(autoincrement())
  customerId Int
  url        String
  verified   Boolean  @default(false)
  createdAt  DateTime @default(now())
  orders     Order[]
  user       User     @relation(fields: [customerId], references: [id], onDelete: Cascade)
}

model Order {
  id                   Int             @id @default(autoincrement())
  customerId           Int
  pharmacyId           Int
  riderId              Int?
  status               OrderStatus     @default(PENDING)
  totalPrice           Float
  createdAt            DateTime        @default(now())
  updatedAt            DateTime        @updatedAt
  deletedAt            DateTime?
  paymentMode          PaymentMode     @default(PAY_AFTER_ACCEPT)
  prescriptionId       Int?
  requiresPrescription Boolean         @default(false)
  customer             User            @relation("CustomerOrders", fields: [customerId], references: [id], onDelete: Cascade)
  pharmacy             User            @relation("PharmacyOrders", fields: [pharmacyId], references: [id], onDelete: Cascade)
  prescription         Prescription?   @relation(fields: [prescriptionId], references: [id])
  rider                User?           @relation("RiderOrders", fields: [riderId], references: [id])
  items                OrderItem[]
  offers               OrderOffer[]
  timeline             OrderTimeline[]
}

model OrderItem {
  id         Int       @id @default(autoincrement())
  orderId    Int
  medicineId Int?
  name       String
  quantity   Int
  price      Float
  medicine   Medicine? @relation(fields: [medicineId], references: [id])
  order      Order     @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model OrderOffer {
  id         Int      @id @default(autoincrement())
  orderId    Int
  pharmacyId Int?
  riderId    Int?
  offeredTo  String
  status     String   @default("PENDING")
  createdAt  DateTime @default(now())
  order      Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
}

model Notification {
  id         Int      @id @default(autoincrement())
  senderId   Int?
  receiverId Int
  type       String
  message    String
  meta       Json?
  status     String   @default("UNREAD")
  createdAt  DateTime @default(now())
  receiver   User     @relation("ReceivedNotifications", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User?    @relation("SentNotifications", fields: [senderId], references: [id])
}

model Session {
  id            Int            @id @default(autoincrement())
  userId        Int
  ip            String?
  userAgent     String?
  createdAt     DateTime       @default(now())
  expiresAt     DateTime
  revoked       Boolean        @default(false)
  refreshTokens RefreshToken[] @relation("SessionToRefreshTokens")
  user          User           @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model RefreshToken {
  id        Int      @id @default(autoincrement())
  userId    Int
  sessionId Int?
  tokenHash String
  revoked   Boolean  @default(false)
  createdAt DateTime @default(now())
  expiresAt DateTime
  session   Session? @relation("SessionToRefreshTokens", fields: [sessionId], references: [id], onDelete: Cascade)
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model AuditLog {
  id        Int      @id @default(autoincrement())
  userId    Int?
  action    String
  resource  String?
  meta      Json?
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model LoginAudit {
  id        Int      @id @default(autoincrement())
  userId    Int?
  email     String?
  ip        String?
  userAgent String?
  eventType String
  role      String?
  success   Boolean  @default(true)
  timestamp DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
}

model SurgeEvent {
  id         Int      @id @default(autoincrement())
  multiplier Float
  meta       Json?
  createdAt  DateTime @default(now())
}

model ChatMessage {
  id         Int      @id @default(autoincrement())
  senderId   Int
  receiverId Int
  text       String
  createdAt  DateTime @default(now())
  receiver   User     @relation("UserReceivedMessages", fields: [receiverId], references: [id], onDelete: Cascade)
  sender     User     @relation("UserSentMessages", fields: [senderId], references: [id], onDelete: Cascade)
}

model Cart {
  id        String     @id @default(cuid())
  userId    String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
  items     CartItem[] @relation("CartItems")

  @@index([userId])
}

model CartItem {
  id        String  @id @default(cuid())
  cartId    String
  productId String
  quantity  Int
  price     Decimal @db.Decimal(12, 2)
  cart      Cart    @relation("CartItems", fields: [cartId], references: [id])

  @@index([cartId])
}

model Transaction {
  id              String   @id @default(cuid())
  provider        String
  providerOrder   String?
  providerPayment String?
  amount          Decimal  @db.Decimal(12, 2)
  currency        String   @default("INR")
  status          String
  method          String?
  rawData         Json?
  createdAt       DateTime @default(now())
  orderId         Int?

  @@index([orderId])
  @@index([providerOrder])
}

model PaymentAttempt {
  id            String   @id @default(cuid())
  attemptData   Json?
  createdAt     DateTime @default(now())
  providerOrder String?
}

model OrderTimeline {
  id        Int      @id @default(autoincrement())
  orderId   Int
  event     String
  data      String?
  createdAt DateTime @default(now())
  order     Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
}

enum UserRole {
  ADMIN
  CUSTOMER
  PHARMACY
  RIDER
}

enum OrderStatus {
  PENDING
  ACCEPTED
  REJECTED
  ASSIGNED
  OUT_FOR_DELIVERY
  REACHED_PHARMACY
  PICKED_UP
  DELIVERED
  CANCELED
  PAID
}

enum MedicineCategory {
  NON_RX
  CHRONIC
  STRICT_RX
}

enum PrescriptionType {
  NONE
  SOFT
  HARD
}

enum PaymentMode {
  PAY_FIRST
  PAY_AFTER_ACCEPT
  PAY_AFTER_VERIFICATION
}

model OtpRequest {
  id        Int      @id @default(autoincrement())
  phone     String
  otp       String
  expiresAt DateTime
  createdAt DateTime @default(now())
}

model PartnerProfile {
  id        Int      @id @default(autoincrement())
  userId    Int      @unique
  role      UserRole
  data      Json
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}

model VerificationDocument {
  id        Int      @id @default(autoincrement())
  userId    Int
  url       String
  type      String
  verified  Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
